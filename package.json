{
  "name": "pexip-court-hearing-control",
  "version": "1.0.0",
  "description": "Room-scoped Pexip Web App 3 hearing start and pause control.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "verify:dist": "node tools/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser:evidence": "node test/browser/visual-evidence.mjs",
    "test:live:pexip": "node test/live/pexip-live-validation.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@pexip/plugin-api": "22.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "playwright-core": "^1.55.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.6"
  }
}
